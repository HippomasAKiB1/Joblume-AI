DATABASE_URL=sqlite+aiosqlite:///./joblume.db
# For PostgreSQL / Neon production (Dual-Connection Architecture):
# DATABASE_URL: Pooled endpoint for FastAPI asyncpg runtime (PgBouncer)
# DATABASE_URL=postgresql://user:password@ep-xyz-pooler.c-2.region.aws.neon.tech/neondb?sslmode=require
# DIRECT_DATABASE_URL: Direct unpooled endpoint for Alembic migrations and DDL operations
# DIRECT_DATABASE_URL=postgresql://user:password@ep-xyz.c-2.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/auto

FRONTEND_URL=http://localhost:5173
